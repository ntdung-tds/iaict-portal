APP_ENV=development
APP_VERSION=0.1.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLOUDFLARE_ACCOUNT_ID=
# Set CLOUDFLARE_API_TOKEN only in local secret storage or CI secrets; never commit a real token.
CLOUDFLARE_API_TOKEN=

# Admin CMS authentication. Set real values only in deployment/local secret storage.
IAICT_ADMIN_USERNAME=admin
IAICT_ADMIN_PASSWORD=
IAICT_ADMIN_SESSION_SECRET=
# Optional for the current single-account bootstrap: editor | reviewer | superadmin.
# If omitted, the account is treated as superadmin.
IAICT_ADMIN_ROLE=superadmin

# Vercel Blob CMS storage. Managed by the deployment environment; never commit a real token.
BLOB_READ_WRITE_TOKEN=