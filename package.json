{
  "name": "iaict-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vite dev",
    "build": "next build",
    "build:vinext": "vite build",
    "start": "next start",
    "check:vinext": "vinext check",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify": "npm run verify:migrations && npm run typecheck && npm run test && npm run build",
    "verify:vinext": "npm run check:vinext && npm run build:vinext",
    "deploy:staging": "vinext-cloudflare deploy --env staging --name iaict-portal-staging",
    "deploy:production": "npm run deploy:cloudflare"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@vercel/blob": "^2.6.1",
    "@vinext/cloudflare": "latest",
    "next": "16.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "sanitize-html": "^2.17.0",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "latest",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "latest",
    "wrangler": "^4.149.0"
  }
}
