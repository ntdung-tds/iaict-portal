{
  "name": "iaict-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:staging": "IAICT_DEPLOY_TARGET=staging vite build --mode staging",
    "build:production": "IAICT_DEPLOY_TARGET=production vite build --mode production",
    "start": "vite preview",
    "check:vinext": "vinext check",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:release-safety": "node scripts/verify-release-safety.mjs",
    "verify:access-paths": "node --test scripts/audit-access-paths.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run verify:migrations && npm run verify:release-safety && npm run verify:access-paths && npm run check:vinext && npm run typecheck && npm run test && npm run build",
    "migrate:staging": "node scripts/apply-staging-migrations.mjs",
    "migrate:production": "node scripts/apply-production-migrations.mjs",
    "prepare:cf-output": "node scripts/prepare-cloudflare-build-output.mjs",
    "deploy:staging": "npm run migrate:staging && npm run prepare:cf-output && IAICT_DEPLOY_TARGET=staging vinext-cloudflare deploy --env staging --skip-build",
    "deploy:production": "npm run migrate:production && npm run prepare:cf-output && IAICT_DEPLOY_TARGET=production vinext-cloudflare deploy --env production --skip-build"
  },
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "next": "^16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "latest",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "latest",
    "wrangler": "^4.149.0"
  }
}
